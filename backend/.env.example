# Copy this file to backend/.env and fill in your values.
# backend/.env is git-ignored, so your key is never committed.
# Restart the backend after changing it (--reload only watches .py files).

# Required for the Claude agents. Create one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Claude model used by all four agents.
# STEM_AGENT_MODEL=claude-opus-5-5

# Optional: model for the STEM and STS-EDP agents only (defaults to STEM_AGENT_MODEL).
# claude-sonnet-5-5 makes these two steps faster and cheaper.
# STEM_SUPPORT_AGENT_MODEL=claude-sonnet-5-5

# Optional: set to "template" to use the placeholder agents (no API key needed).
# STEM_AGENTS=template

# Optional, recommended in production: a long random string that signs the
# suggested problems, so problem lists stay valid across server restarts.
# GUARDRAIL_SECRET=

# Teacher sign-in (Supabase, email link or code). Required unless STEM_AUTH=off.
# Find both in Supabase: Project Settings -> API (Project URL, anon/publishable key).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Set to "off" to run without sign-in (local development only; anyone can generate).
# STEM_AUTH=off

# Optional per-teacher daily limits (UTC days). Defaults: 30 and 10.
# DAILY_PROBLEM_LIMIT=30
# DAILY_LESSON_PLAN_LIMIT=10
