# Copy this file to backend/.env and fill in your values.
# backend/.env is git-ignored, so your key is never committed.
# Restart the backend after changing it (--reload only watches .py files).

# Required for the Claude agents. Create one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Claude model used by all four agents.
# STEM_AGENT_MODEL=claude-opus-5-5

# Optional: set to "template" to use the placeholder agents (no API key needed).
# STEM_AGENTS=template

# Optional, recommended in production: a long random string that signs the
# suggested problems, so problem lists stay valid across server restarts.
# GUARDRAIL_SECRET=
